rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isAuthenticated()
        && groupId != null
        && groupId != ''
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    function isGroupAdmin(groupId) {
      return isAuthenticated()
        && groupId != null
        && groupId != ''
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminUids;
    }

    // Players are shared across all authenticated users (global registry)
    match /players/{playerId} {
      allow read, write: if isAuthenticated();
    }

    // Groups are scoped to their members; only admins can modify membership
    match /groups/{groupId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.memberUids;

      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.auth.uid in request.resource.data.adminUids;

      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.adminUids ||
        // Allow non-admin to add themselves when accepting an invite
        (
          request.auth.uid in request.resource.data.memberUids &&
          !(request.auth.uid in resource.data.memberUids)
        )
      );

      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }

    // Sessions are scoped to their group's members
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.groupId == ''
        || isGroupMember(resource.data.groupId)
      );

      allow create: if isAuthenticated() && (
        request.resource.data.groupId == ''
        || isGroupMember(request.resource.data.groupId)
      );

      allow update, delete: if isAuthenticated() && (
        resource.data.groupId == ''
        || isGroupMember(resource.data.groupId)
      );
    }

    // Invites — created by group admins, read/updated by the invited user
    match /invites/{inviteId} {
      allow create: if isAuthenticated() && isGroupAdmin(request.resource.data.groupId);
      allow read: if isAuthenticated() && (
        resource.data.invitedEmail == request.auth.token.email ||
        isGroupAdmin(resource.data.groupId)
      );
      allow update: if isAuthenticated() &&
        resource.data.invitedEmail == request.auth.token.email &&
        resource.data.status == 'pending';
      allow delete: if isAuthenticated() && isGroupAdmin(resource.data.groupId);
    }

    // Settlements are scoped to their group's members
    match /settlements/{settlementId} {
      allow read: if isAuthenticated() && (
        resource.data.groupId == ''
        || isGroupMember(resource.data.groupId)
      );

      allow create: if isAuthenticated() && (
        request.resource.data.groupId == ''
        || isGroupMember(request.resource.data.groupId)
      );

      allow update, delete: if isAuthenticated() && (
        resource.data.groupId == ''
        || isGroupMember(resource.data.groupId)
      );
    }
  }
}
